<Window x:Class="CyberForgeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberForge Studio | Android Service Tool"
        Height="720" Width="1080"
        MinHeight="650" MinWidth="920"
        Background="#E9EDF2" Foreground="#202B36"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Color Tokens -->
        <SolidColorBrush x:Key="HeaderBg" Color="#1769AA"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#F5F7F9"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#C8D0D8"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#202B36"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#657380"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#1769AA"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#0E568F"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#27834A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#C54444"/>

        <!-- Brand Selector Buttons Style -->
        <Style x:Key="BrandBtn" TargetType="Button">
            <Setter Property="Background" Value="#F5F7F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E4F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EAF3FA"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlueHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Controls Styling -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="#E9EDF2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="2,2,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Brand Selector -->
            <RowDefinition Height="*"/>    <!-- Main Split Section -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- BRAND SELECTOR -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="5" Margin="0,0,0,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BrandSelector" Orientation="Horizontal">
                    <Button Content="SAMSUNG" Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="SAMSUNG" Background="{StaticResource AccentBlue}" Foreground="White"/>
                    <Button Content="XIAOMI" Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="XIAOMI" Foreground="#FB923C"/>
                    <Button Content="LG" Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="LG" Foreground="#F43F5E"/>
                    <Button Content="ANDROID" Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="ANDROID" Foreground="#4ADE80"/>
                    <Button Content="QUALCOMM" Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="QUALCOMM" Foreground="#F87171"/>
                    <Button Content="MEDIATEK" Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="MEDIATEK" Foreground="#FB923C"/>
                    <Button Content="UNISOC" Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="UNISOC" Foreground="#A855F7"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT OPERATIONS -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="0,0,5,0" Padding="7">
                <TabControl x:Name="OperationTabs" Background="Transparent" BorderThickness="0">
                    <!-- FRP TAB -->
                    <TabItem Header="Account">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="DEVICE STATUS &amp; ACCOUNT RECOVERY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="&#x1F50D; Scan ADB and Fastboot devices"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnReadInfo_Click" Content="&#x2139; Read connected device information"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnLink_Click" Tag="https://accounts.google.com/signin/recovery" Content="&#x1F310; Open official Google account recovery"/>
                                <TextBlock Text="Account locks must be recovered through the device owner's account or the manufacturer." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="2,6,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- MTP TAB -->
                    <TabItem Header="USB / MTP">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="USB CONNECTION &amp; FILE TRANSFER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="Scan ADB and Fastboot interfaces"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnDeviceManager_Click" Content="&#x1F4F1; Open Windows Device Manager"/>
                                <TextBlock Text="MTP file browsing is handled by Windows File Explorer." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="2,4,2,0"/>
                                <TextBlock Text="Factory reset is not supported over MTP in this build." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="2,6,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ADB TAB -->
                    <TabItem Header="ADB">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="ADB DIAGNOSTICS &amp; ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnReadInfo_Click" Content="🔍 Read ADB Device Info"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnAdbRebootRecovery_Click" Content="🔄 Reboot to Recovery Mode"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnAdbRebootDownload_Click" Content="⚡ Reboot to Download / Bootloader Mode"/>
                                <TextBlock Text="Knox management requires Samsung-authorized service software." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="2,4,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- MTK TAB -->
                    <TabItem Header="MTK">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="MEDIATEK DEVICE DIAGNOSTICS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="Scan ADB and Fastboot interfaces"/>
                                <TextBlock Text="Direct MediaTek BROM/authentication service operations are not implemented. No device changes are made by this scan." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="2,4,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- EDL / QUALCOMM TAB -->
                    <TabItem Header="EDL (QC9008)">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="QUALCOMM DEVICE DIAGNOSTICS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="Scan ADB and Fastboot interfaces"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnDeviceManager_Click" Content="Open Windows Device Manager"/>
                                <TextBlock Text="EDL 9008 servicing requires signed programmer files and a supported service protocol, which are not included." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="2,4,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- RIGHT CONSOLE MONITOR -->
            <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Margin="5,0,0,0" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Banner -->
                    <Border Grid.Row="0" Background="{StaticResource HeaderBg}" CornerRadius="2" Padding="10,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CF" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CYBERFORGE STUDIO" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Android Service Tool" FontSize="10" Foreground="#E1EFF9"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="v1.0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Quick Controls -->
                    <Grid Grid.Row="1" Margin="0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="&#x1F50E; Scan devices" Click="BtnScanDevices_Click" Style="{StaticResource ActionButton}" Margin="0,0,4,0" Padding="8,4"/>
                            <Button Content="&#x1F4F1; Device Manager" Click="BtnDeviceManager_Click" Style="{StaticResource ActionButton}" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ℹ️ Info" Click="BtnReadInfo_Click" Style="{StaticResource ActionButton}" Margin="0,0,4,0" Padding="10,4"/>
                            <Button Content="🔄 Reboot" Click="BtnReboot_Click" Style="{StaticResource ActionButton}" Background="{StaticResource AccentRed}" Foreground="White" BorderThickness="0" Padding="10,4"/>
                        </StackPanel>
                    </Grid>

                    <!-- Terminal Output Console -->
                    <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="5">
                        <ListBox x:Name="LstLogs" Background="Transparent" BorderThickness="0" Foreground="#34495E" FontFamily="Consolas" FontSize="10"/>
                    </Border>

                    <!-- Footer Controls -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtSystemInfo" Text="Host OS" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                        <Button Content="Clear Logs" Click="BtnClearLogs_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Right" Padding="10,3"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,8,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🌐 Firmware DB" Click="BtnLink_Click" Tag="https://samfw.com" Style="{StaticResource BrandBtn}"/>
                    <Button Content="💬 Support Group" Click="BtnLink_Click" Tag="https://t.me" Style="{StaticResource BrandBtn}"/>
                    <Button Content="📺 Tutorials" Click="BtnLink_Click" Tag="https://youtube.com" Style="{StaticResource BrandBtn}"/>
                </StackPanel>
                <TextBlock x:Name="TxtLoginStatus" Text="Status: Ready" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>