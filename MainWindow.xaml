<Window x:Class="CyberForgeStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberForge Studio 1.0"
        Height="680" Width="1000"
        MinHeight="560" MinWidth="820"
        Background="#EEF2F6" Foreground="#243247"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBg" Color="#F5F8FB"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D2DAE4"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#243247"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#67778A"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#1769AA"/>
        <SolidColorBrush x:Key="AccentHover" Color="#E8F3FC"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#18A6A1"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#278459"/>
        <SolidColorBrush x:Key="AccentRed" Color="#C9474F"/>

        <Style x:Key="BrandBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentHover}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#D7EAF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentHover}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="#E8EDF3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="2,2,0,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" MinHeight="30"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="58" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="360"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5">
                <WrapPanel x:Name="BrandSelector" VerticalAlignment="Center">
                    <Button Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="SAMSUNG" Background="{StaticResource AccentBlue}" Foreground="White">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" Background="#0F4F8A" CornerRadius="9" Margin="0,0,5,0"><TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="SAMSUNG" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="XIAOMI">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" Background="#F47721" CornerRadius="4" Margin="0,0,5,0"><TextBlock Text="mi" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="XIAOMI" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="LG">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" Background="#B21E69" CornerRadius="9" Margin="0,0,5,0"><TextBlock Text="L" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="LG" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="ANDROID">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" Background="#3AAB58" CornerRadius="9" Margin="0,0,5,0"><TextBlock Text="A" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ANDROID" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="QUALCOMM">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" Background="#D7443E" CornerRadius="9" Margin="0,0,5,0"><TextBlock Text="Q" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="QUALCOMM" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="MEDIATEK">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" Background="#E97A24" CornerRadius="9" Margin="0,0,5,0"><TextBlock Text="M" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="MEDIATEK" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BrandBtn}" Click="BtnBrand_Click" Tag="UNISOC">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="18" Height="18" Background="#6874C8" CornerRadius="9" Margin="0,0,5,0"><TextBlock Text="U" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="UNISOC" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </WrapPanel>
            </Border>
            <Border Grid.Column="1" Background="#263E6B" Margin="6,0,0,0" Padding="12,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Background="{StaticResource AccentTeal}" CornerRadius="8" Margin="0,0,9,0">
                            <TextBlock Text="CF" Foreground="White" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CYBERFORGE STUDIO" FontSize="19" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="ANDROID SERVICE TOOL" FontSize="9" FontWeight="Bold" Foreground="#C9D9EC"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="1.0" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="White" FontSize="9" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="360"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5" Margin="0,0,3,0">
                <TabControl x:Name="OperationTabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Account">
                        <Grid Margin="3,7,3,3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="DEVICE STATUS &amp; ACCOUNT RECOVERY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6"/>
                            <StackPanel Grid.Row="1">
                                <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="Scan ADB / Fastboot connection"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnReadInfo_Click" Content="Read connected device information"/>
                                <Button Style="{StaticResource ActionButton}" Click="BtnLink_Click" Tag="https://accounts.google.com/signin/recovery" Content="Open official Google account recovery"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Account locks must be recovered by the device owner or manufacturer." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="2,5,2,0"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="ADB">
                        <StackPanel Margin="3,7,3,3">
                            <TextBlock Text="ADB DEVICE ACTIONS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnReadInfo_Click" Content="Read ADB device information"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnAdbRebootRecovery_Click" Content="Reboot to Recovery"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnAdbRebootDownload_Click" Content="Reboot to Download / Bootloader"/>
                            <TextBlock Text="Reboot commands require an authorized ADB connection." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="2,3,2,0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="USB">
                        <StackPanel Margin="3,7,3,3">
                            <TextBlock Text="USB CONNECTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="Scan ADB and Fastboot interfaces"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnDeviceManager_Click" Content="Open Windows Device Manager"/>
                            <TextBlock Text="MTP file browsing is provided by Windows File Explorer." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="2,3,2,0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="MTK">
                        <StackPanel Margin="3,7,3,3">
                            <TextBlock Text="MEDIATEK DEVICE DIAGNOSTICS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="Scan ADB and Fastboot interfaces"/>
                            <TextBlock Text="Direct BROM/authentication servicing is not available in this build." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="2,3,2,0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="EDL (QC9008)">
                        <StackPanel Margin="3,7,3,3">
                            <TextBlock Text="QUALCOMM DEVICE DIAGNOSTICS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="2,0,0,6"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnScanDevices_Click" Content="Scan ADB and Fastboot interfaces"/>
                            <Button Style="{StaticResource ActionButton}" Click="BtnDeviceManager_Click" Content="Open Windows Device Manager"/>
                            <TextBlock Text="EDL servicing requires signed programmer files and a supported protocol." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="9" Margin="2,3,2,0"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5" Margin="3,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Button Content="Device Manager" Click="BtnDeviceManager_Click" Style="{StaticResource BrandBtn}" Padding="7,4" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Info" Click="BtnReadInfo_Click" Style="{StaticResource BrandBtn}" Padding="8,4"/>
                                <Button Content="Reboot" Click="BtnReboot_Click" Style="{StaticResource BrandBtn}" Background="{StaticResource AccentRed}" Foreground="White" Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device" VerticalAlignment="Center" Margin="1,0,5,0" FontSize="9" Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox x:Name="CmbDevices" Grid.Column="1" DisplayMemberPath="DisplayName" MinHeight="25" VerticalContentAlignment="Center" ToolTip="Select a connected ADB or Fastboot device"/>
                            <Button Grid.Column="2" Content="Scan" Click="BtnScanDevices_Click" Style="{StaticResource BrandBtn}" Padding="7,3" Margin="4,0,0,0"/>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="1" Background="#F4F4F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4">
                        <ListBox x:Name="LstLogs" Background="Transparent" BorderThickness="0" Foreground="#393939" FontFamily="Consolas" FontSize="9"/>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <TextBlock x:Name="TxtSystemInfo" Text="Host OS" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="8"/>
                        <Button Content="Clear log" Click="BtnClearLogs_Click" Style="{StaticResource BrandBtn}" HorizontalAlignment="Right" Padding="7,3"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5,2">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Samsung firmware" Click="BtnLink_Click" Tag="https://samfw.com" Style="{StaticResource BrandBtn}" Padding="5,2" FontSize="8"/>
                    <Button Content="Telegram" Click="BtnLink_Click" Tag="https://t.me" Style="{StaticResource BrandBtn}" Padding="5,2" FontSize="8"/>
                    <Button Content="Video" Click="BtnLink_Click" Tag="https://youtube.com" Style="{StaticResource BrandBtn}" Padding="5,2" FontSize="8"/>
                </StackPanel>
                <TextBlock x:Name="TxtLoginStatus" Text="Brand: SAMSUNG" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9"/>
            </Grid>
        </Border>
    </Grid>
</Window>